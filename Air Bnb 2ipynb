    {
      "cell_type": "code",
      "source": [
        "from sklearn.cluster import KMeans\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "# Normalize price data\n",
        "price_data = df[['id', 'price']].dropna()\n",
        "price_data['price'] = pd.to_numeric(price_data['price'], errors='coerce')\n",
        "\n",
        "# Remove outliers by filtering extreme prices\n",
        "# price_data = price_data[(price_data['price'] >= lower_bound) & (price_data['price'] <= upper_bound)]\n",
        "\n",
        "# Scale price data\n",
        "scaler = StandardScaler()\n",
        "scaled_price_data = scaler.fit_transform(price_data[['price']])\n",
        "\n",
        "# Apply KMeans clustering\n",
        "kmeans = KMeans(n_clusters=5, random_state=42)  # 5 clusters as an example\n",
        "price_data['price_cluster'] = kmeans.fit_predict(scaled_price_data)\n",
        "\n",
        "# Plot the price clusters\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.scatter(price_data['id'], price_data['price'], c=price_data['price_cluster'], cmap='viridis')\n",
        "plt.xlabel('Listing ID')\n",
        "plt.ylabel('Price')\n",
        "plt.title('Price Clusters of Listings')\n",
        "plt.show()"
